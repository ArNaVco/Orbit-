DATABASE_URL="postgresql://orbit:orbit@localhost:5433/orbit?schema=public"
DATABASE_URL_UNPOOLED="postgresql://orbit:orbit@localhost:5433/orbit?schema=public"
APP_URL="http://localhost:3000"
# Optional SMTP. When unset, emails (verification/reset links) are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Orbit <no-reply@orbit.local>"
# Seeded super admin (change before deploying)
SEED_SUPERADMIN_EMAIL="admin@orbit.local"
SEED_SUPERADMIN_PASSWORD="Admin@12345"
# Set automatically on Vercel when a Blob store is connected. When set, uploads go to Vercel Blob instead of ./uploads
BLOB_READ_WRITE_TOKEN=""
# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SECRET_KEY="change-me-to-a-long-random-string"
